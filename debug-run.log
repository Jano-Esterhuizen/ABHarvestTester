Γöé  ### **Test Utilities**                                                     Γöé
Γöé  ```csharp                                                                  Γöé
Γöé  public static class TestUtilities                                          Γöé
Γöé  {                                                                          Γöé
Γöé      public static async Task<T>                                            Γöé
Γöé  DeserializeResponse<T>(HttpResponseMessage response)                       Γöé
Γöé      {                                                                      Γöé
Γöé          var content = await response.Content.ReadAsStringAsync();          Γöé
Γöé          return JsonSerializer.Deserialize<T>(content, new                  Γöé
Γöé  JsonSerializerOptions                                                      Γöé
Γöé          {                                                                  Γöé
Γöé              PropertyNamingPolicy = JsonNamingPolicy.CamelCase              Γöé
Γöé          });                                                                Γöé
Γöé      }                                                                      Γöé
Γöé                                                                             Γöé
Γöé      public static DbContextOptions<ApplicationDbContext>                   Γöé
Γöé  GetInMemoryDbOptions()                                                     Γöé
Γöé      {                                                                      Γöé
Γöé          return new DbContextOptionsBuilder<ApplicationDbContext>()         Γöé
Γöé              .UseInMemoryDatabase(databaseName: Guid.NewGuid().ToString())  Γöé
Γöé              .Options;                                                      Γöé
Γöé      }                                                                      Γöé
Γöé                                                                             Γöé
Γöé      public static async Task SeedTestData(ApplicationDbContext context)    Γöé
Γöé      {                                                                      Γöé
Γöé          var cities = new[]                                                 Γöé
Γöé          {                                                                  Γöé
Γöé              TestDataGenerator.CreateValidCity("Cape Town", "South          Γöé
Γöé  Africa"),                                                                  Γöé
Γöé              TestDataGenerator.CreateValidCity("Johannesburg", "South       Γöé
Γöé  Africa"),                                                                  Γöé
Γöé              TestDataGenerator.CreateValidCity("Durban", "South Africa")    Γöé
Γöé          };                                                                 Γöé
Γöé                                                                             Γöé
Γöé          context.Cities.AddRange(cities);                                   Γöé
Γöé          await context.SaveChangesAsync();                                  Γöé
Γöé                                                                             Γöé
Γöé          var weather = cities.Select(city =>                                Γöé
Γöé              TestDataGenerator.CreateValidWeather(city.Id, 20 +             Γöé
Γöé  Random.Shared.Next(0, 20))                                                 Γöé
Γöé          );                                                                 Γöé
Γöé                                                                             Γöé
Γöé          context.Weather.AddRange(weather);                                 Γöé
Γöé          await context.SaveChangesAsync();                                  Γöé
Γöé      }                                                                      Γöé
Γöé  }                                                                          Γöé
Γöé  ```                                                                        Γöé
Γöé                                                                             Γöé
