Γöé  _client.GetAsync($"/api/weather/city/{cityId}");                           Γöé
Γöé          weatherForCityResponse.EnsureSuccessStatusCode();                  Γöé
Γöé                                                                             Γöé
Γöé          var weatherData = await                                            Γöé
Γöé  weatherForCityResponse.Content.ReadAsStringAsync();                        Γöé
Γöé          weatherData.Should().Contain("Perfect weather for E2E testing");   Γöé
Γöé                                                                             Γöé
Γöé          // 4. Verify city appears in cities list                           Γöé
Γöé          var allCitiesResponse = await _client.GetAsync("/api/cities");     Γöé
Γöé          allCitiesResponse.EnsureSuccessStatusCode();                       Γöé
Γöé                                                                             Γöé
Γöé          var citiesData = await                                             Γöé
Γöé  allCitiesResponse.Content.ReadAsStringAsync();                             Γöé
Γöé          citiesData.Should().Contain("E2E Test City");                      Γöé
Γöé      }                                                                      Γöé
Γöé  }                                                                          Γöé
Γöé  ```                                                                        Γöé
