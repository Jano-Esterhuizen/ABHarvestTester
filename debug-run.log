Γöé  Uri("http://localhost:8080") };                                            Γöé
Γöé      }                                                                      Γöé
Γöé                                                                             Γöé
Γöé      [Test]                                                                 Γöé
Γöé      public async Task Should_DistributeRequestsAcrossInstances()           Γöé
Γöé      {                                                                      Γöé
Γöé          // Arrange                                                         Γöé
Γöé          var instanceIds = new HashSet<string>();                           Γöé
Γöé          var requestCount = 20;                                             Γöé
Γöé                                                                             Γöé
Γöé          // Act - Make multiple requests                                    Γöé
Γöé          for (int i = 0; i < requestCount; i++)                             Γöé
Γöé          {                                                                  Γöé
Γöé              var response = await _client.GetAsync("/api/cities");          Γöé
Γöé              response.EnsureSuccessStatusCode();                            Γöé
Γöé                                                                             Γöé
Γöé              var content = await response.Content.ReadAsStringAsync();      Γöé
Γöé              var responseObj =                                              Γöé
Γöé  JsonSerializer.Deserialize<JsonElement>(content);                          Γöé
Γöé                                                                             Γöé
Γöé              if (responseObj.TryGetProperty("servedBy", out var             Γöé
Γöé  instanceProperty))                                                         Γöé
Γöé              {                                                              Γöé
Γöé                  instanceIds.Add(instanceProperty.GetString());             Γöé
Γöé              }                                                              Γöé
Γöé          }                                                                  Γöé
Γöé                                                                             Γöé
Γöé          // Assert - Should have requests from multiple instances           Γöé
Γöé          instanceIds.Should().HaveCountGreaterThan(1,                       Γöé
Γöé              "Load balancer should distribute requests across multiple      Γöé
Γöé  instances");                                                               Γöé
Γöé      }                                                                      Γöé
Γöé                                                                             Γöé
